# Variables de entorno del BACKEND (norda-backend).
#
# Spring Boot no lee este archivo directamente: son variables de entorno reales
# del sistema operativo o de la plataforma de despliegue (Render, Railway, Fly.io...).
# En local puedes exportarlas en tu shell, o dejar que se usen los valores por
# defecto de application-local.yml (validos solo para desarrollo).
#
# El frontend SI lee su propio .env (ver frontend/.env.example) porque Vite
# soporta archivos .env de forma nativa.

SPRING_PROFILES_ACTIVE=local

# PostgreSQL: local (instalado en tu maquina) o gestionado (Render/Railway/Neon/Supabase...).
# DATABASE_URL debe ser una URL JDBC: jdbc:postgresql://host:puerto/basededatos
DATABASE_URL=jdbc:postgresql://localhost:5432/norda
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Origenes autorizados por CORS (separados por coma si hay varios).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# URL publica del frontend (usada para construir enlaces, p.ej. reseteo de contrasena).
FRONTEND_URL=http://localhost:5173

# Secreto para firmar los JWT de autenticacion. Genera uno propio en produccion,
# por ejemplo: openssl rand -base64 48
JWT_SECRET=local-only-dev-secret-do-not-use-in-production-0123456789

# Stripe (fase 8). En modo demo no se usan claves reales.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Puerto HTTP del backend (algunas plataformas lo inyectan automaticamente).
PORT=8080
